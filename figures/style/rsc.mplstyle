# Generated by figures/style/build_style.py from rsc_spec.yaml and palette.yaml; do not edit.
# Each line names the spec entry it traces to.

## Font
font.family                 : sans-serif                         # applied.font_family
font.sans-serif             : Arial, Helvetica                   # applied.font_family
mathtext.fontset            : custom                             # applied.font_family (mathtext in the same family)
mathtext.rm                 : sans                               # applied.font_family
mathtext.it                 : sans:italic                        # applied.font_family
mathtext.bf                 : sans:bold                          # applied.font_family
mathtext.sf                 : sans                               # applied.font_family
mathtext.cal                : sans:italic                        # applied.font_family (no second family for calligraphic)
mathtext.tt                 : sans                               # applied.font_family (no second family for typewriter)
mathtext.fallback           : None                               # applied.font_family (no silent fallback to another family)
axes.unicode_minus          : True                               # applied.font_family (true minus sign from the same font)
font.size                   : 7                                  # applied.font_size
axes.labelsize              : 7                                  # applied.font_size
axes.titlesize              : 7                                  # applied.font_size
xtick.labelsize             : 7                                  # applied.font_size
ytick.labelsize             : 7                                  # applied.font_size
legend.fontsize             : 7                                  # applied.font_size
figure.titlesize            : 7                                  # applied.font_size
figure.labelsize            : 7                                  # applied.font_size
axes.titleweight            : bold                               # applied.panel_letter
axes.titlelocation          : left                               # applied.panel_letter

## Lines
axes.linewidth              : 0.5                                # applied.line_width_min
xtick.major.width           : 0.5                                # applied.line_width_min
ytick.major.width           : 0.5                                # applied.line_width_min
xtick.minor.width           : 0.5                                # applied.line_width_min
ytick.minor.width           : 0.5                                # applied.line_width_min
patch.linewidth             : 0.5                                # applied.line_width_min
hatch.linewidth             : 0.5                                # applied.line_width_min
lines.markeredgewidth       : 0.5                                # applied.line_width_min
contour.linewidth           : 0.5                                # applied.line_width_min
grid.linewidth              : 0.5                                # applied.line_width_min
lines.linewidth             : 1                                  # applied.line_width_data
lines.markersize            : 3.2                                # applied.marker_size
xtick.major.size            : 3.2                                # applied.tick_length
xtick.minor.size            : 1.6                                # applied.tick_length / 2
ytick.major.size            : 3.2                                # applied.tick_length
ytick.minor.size            : 1.6                                # applied.tick_length / 2
errorbar.capsize            : 0                                  # applied.errorbar_capsize
contour.negative_linestyle  : solid                              # applied.contour_linestyle

## Colour
text.color                  : 000000                             # applied.text_colour
axes.edgecolor              : 000000                             # applied.text_colour
axes.labelcolor             : 000000                             # applied.text_colour
xtick.color                 : 000000                             # applied.text_colour
ytick.color                 : 000000                             # applied.text_colour
xtick.labelcolor            : 000000                             # applied.text_colour
ytick.labelcolor            : 000000                             # applied.text_colour
patch.edgecolor             : 000000                             # applied.text_colour
hatch.color                 : 000000                             # applied.text_colour
axes.prop_cycle             : cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', 'CC79A7', '56B4E9', '000000']) # palette.categorical.cycle (Okabe-Ito)

## Axes and layout
xtick.direction             : out                                # applied.tick_direction
ytick.direction             : out                                # applied.tick_direction
axes.spines.top             : False                              # applied.spines_top_right
axes.spines.right           : False                              # applied.spines_top_right
axes.grid                   : False                              # applied.grid
legend.frameon              : False                              # applied.legend (legends are rejected by the checker)
figure.constrained_layout.use: True                               # applied.layout
figure.figsize              : 3.2677, 2.4508                     # applied.width_single_in (default only; each figure sets its own height)

## Output
savefig.dpi                 : 600                                # applied.raster_dpi
figure.dpi                  : 150                                # applied.raster_dpi / 4 (screen preview only)
savefig.format              : pdf                                # applied.vector_format
savefig.bbox                : standard                           # applied.width_single_in / width_double_in (no tight crop; widths are exact)
savefig.transparent         : False                              # applied.text_colour (opaque white ground)
pdf.fonttype                : 42                                 # applied.vector_format (TrueType embedded)
ps.fonttype                 : 42                                 # applied.vector_format (TrueType embedded)
svg.fonttype                : none                               # applied.vector_format (text kept as text)
