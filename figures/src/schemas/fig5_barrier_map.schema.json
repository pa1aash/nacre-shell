{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "fig5 nucleation-barrier map input (ASSUMED; reconcile with configs/preprint/results_schema.json from lane p0-w4)",
 "type": "object",
 "required": [
  "mock",
  "schema",
  "wetting_angle_deg",
  "supersaturation",
  "barrier_kT",
  "thresholds_kT"
 ],
 "additionalProperties": false,
 "properties": {
  "mock": {
   "type": "boolean"
  },
  "schema": {
   "const": "fig5-barrier-map/assumed-v0"
  },
  "note": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "wetting_angle_deg": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 180
   }
  },
  "supersaturation": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "number",
    "minimum": 1
   }
  },
  "barrier_kT": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "array",
    "minItems": 2,
    "items": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "thresholds_kT": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "number",
    "minimum": 0
   }
  }
 }
}
