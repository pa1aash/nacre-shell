{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "fig4 retrodiction outcome input (ASSUMED; reconcile with configs/preprint/results_schema.json from lane p0-w4 and preprint/retrodiction/** from lane p0-w2)",
 "type": "object",
 "required": [
  "mock",
  "schema",
  "quantity",
  "threshold",
  "cases"
 ],
 "additionalProperties": false,
 "properties": {
  "mock": {
   "type": "boolean"
  },
  "schema": {
   "const": "fig4-retrodiction/assumed-v0"
  },
  "note": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "quantity": {
   "type": "object",
   "required": [
    "symbol"
   ],
   "properties": {
    "symbol": {
     "enum": [
      "barrier_het"
     ]
    }
   }
  },
  "threshold": {
   "type": "object",
   "required": [
    "symbol",
    "value"
   ],
   "properties": {
    "symbol": {
     "enum": [
      "barrier_crit"
     ]
    },
    "value": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "predicted",
     "predicted_lo",
     "predicted_hi",
     "observed"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "predicted": {
      "type": "number",
      "minimum": 0
     },
     "predicted_lo": {
      "type": "number",
      "minimum": 0
     },
     "predicted_hi": {
      "type": "number",
      "minimum": 0
     },
     "observed": {
      "enum": [
       "layer_formed",
       "no_layer"
      ]
     }
    }
   }
  }
 }
}
