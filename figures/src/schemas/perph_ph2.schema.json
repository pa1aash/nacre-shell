{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "perph.csv as read by nacre.figs.upstream (lane p0-w4, PH-W4.5)",
 "type": "object",
 "required": [
  "columns",
  "rows"
 ],
 "properties": {
  "mock": {
   "type": "boolean"
  },
  "columns": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "allOf": [
    {
     "contains": {
      "const": "grid"
     }
    },
    {
     "contains": {
      "const": "source"
     }
    },
    {
     "contains": {
      "const": "phase"
     }
    },
    {
     "contains": {
      "const": "pH"
     }
    },
    {
     "contains": {
      "const": "n_cells"
     }
    },
    {
     "contains": {
      "const": "n_passing"
     }
    },
    {
     "contains": {
      "const": "passing_fraction"
     }
    },
    {
     "contains": {
      "const": "min_passing_Ca_T_mol_dm3"
     }
    },
    {
     "contains": {
      "const": "min_passing_P_T_mol_dm3"
     }
    }
   ]
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "grid",
     "source",
     "phase",
     "pH",
     "n_cells",
     "n_passing",
     "passing_fraction",
     "min_passing_Ca_T_mol_dm3",
     "min_passing_P_T_mol_dm3"
    ],
    "properties": {
     "grid": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "phase": {
      "type": "string"
     },
     "pH": {
      "type": "string"
     },
     "n_cells": {
      "type": "string"
     },
     "n_passing": {
      "type": "string"
     },
     "passing_fraction": {
      "type": "string"
     },
     "min_passing_Ca_T_mol_dm3": {
      "type": "string"
     },
     "min_passing_P_T_mol_dm3": {
      "type": "string"
     }
    }
   }
  }
 }
}
